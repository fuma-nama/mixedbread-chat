# https://platform.mixedbread.com/platform?next=api-keys
MXBAI_API_KEY=

# Postgres, e.g. Neon or a local server:
# docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:17
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# A random string, e.g. from `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Only needed outside Vercel, where AI Gateway authenticates on its own.
# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Only needed on a custom domain; localhost and *.vercel.app work as is.
# BETTER_AUTH_URL=https://chat.example.com

# Stores to search, by name or ID. Defaults to the web.
# MXBAI_STORES=my-docs,mixedbread/web
