# The app's OAuth client for "Sign in with Mixedbread". Create one with
# `pnpm mixedbread:register <app URL>`, e.g. http://localhost:3000.
# Deployments register their own when it's unset.
MXBAI_CLIENT_ID=

# Postgres, e.g. Neon or a local server:
# docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:17
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Redis, which carries answers between servers, e.g. Upstash or a local server:
# docker run -d -p 6379:6379 redis
REDIS_URL=redis://localhost:6379

# A random string, e.g. from `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Only needed outside Vercel, where AI Gateway authenticates on its own.
# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=


# For a public demo: the AI Gateway models it offers, the first by default
# (every tool-calling model when unset), and each person's answers a day (100).
# ALLOWED_MODELS=anthropic/claude-sonnet-5,openai/gpt-5.5
# ANSWERS_PER_DAY=20

# Only needed on a custom domain; localhost and *.vercel.app work as is.
# BETTER_AUTH_URL=https://chat.example.com

# Another Mixedbread platform to sign in with, such as a local one.
# MXBAI_PLATFORM_URL=https://www.platform.mixedbread.com
