    "@streamdown/math": "^1.0.2",
    "ai": "^7.0.118",
    "better-auth": "^1.7.6",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "jotai": "^3.0.1",
    "katex": "^0.16.47",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "^6.2.1",
    "resumable-stream": "^2.2.13",
    "streamdown": "^2.6.0",
